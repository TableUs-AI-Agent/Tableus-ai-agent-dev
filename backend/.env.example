# Required for Gemini-powered search, profile updates, and image analysis.
GEMINI_API_KEY=
GEMINI_BACKEND=agent-platform
GEMINI_MODEL=gemini-3.1-flash-lite

# Required only for server-side Places API New location and restaurant lookups.
GOOGLE_MAPS_API_KEY=

# Public URL used when the backend generates place-photo proxy URLs.
BACKEND_PUBLIC_URL=http://localhost:8000

# Closed-beta defaults are deterministic and require no external credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./tableus-dev.db
# Staging/production only: privileged Alembic credential, separate from runtime.
MIGRATION_DATABASE_URL=
# Staging/production only: pre-created least-privilege runtime login role.
TABLEUS_RUNTIME_DB_ROLE=
TABLEUS_AUTH_MODE=demo
TABLEUS_PROVIDER_MODE=deterministic
# Preferred split modes. When omitted, the deprecated combined value above is used.
TABLEUS_PLACES_PROVIDER_MODE=deterministic
TABLEUS_AI_PROVIDER_MODE=deterministic
TABLEUS_DEMO_MODE=true
TABLEUS_SHARED_PLANS_ENABLED=true
TABLEUS_BUILD_SHA=
TABLEUS_DEMO_INVITE=tableus-beta
TABLEUS_APP_SECRET=development-only-change-me-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Required only when TABLEUS_AUTH_MODE=supabase.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Full account deletion is opt-in after migration, recovery runner and client rollout.
# Server only. Never put this credential in NEXT_PUBLIC_* or EXPO_PUBLIC_*.
TABLEUS_ACCOUNT_DELETION_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# Privacy-safe telemetry is fail-closed. Use staging only with isolated staging projects.
TABLEUS_TELEMETRY_MODE=off
TABLEUS_TELEMETRY_E2E=false
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Paid operator evaluation hard ceiling and rolling staging runtime ceiling.
LIVE_AI_MAX_USD=0.25
AI_RUNTIME_MAX_USD_30D=4.00

# Server-controlled operators, by trusted Auth subject. Empty denies everyone.
# Never copy identities or this configuration into public clients.
TABLEUS_OPERATOR_SUBJECTS=
# Proposed closed-beta admission settings, not new live spend authority.
# AI/Places count logical live operations per UTC day, including failed attempts.
COHORT_AI_OPERATIONS_PER_DAY=5
COHORT_PLACES_OPERATIONS_PER_DAY=20
# Prospective creations plus surviving-history backfill; delete/transfer do not refund.
COHORT_PLANS_LIFETIME=20
