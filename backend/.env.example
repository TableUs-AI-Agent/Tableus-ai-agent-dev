# Required for Gemini-powered search, profile updates, and image analysis.
GEMINI_API_KEY=
GEMINI_BACKEND=agent-platform
GEMINI_MODEL=gemini-3.1-flash-lite

# Required only for server-side Places API New location and restaurant lookups.
GOOGLE_MAPS_API_KEY=

# Public URL used when the backend generates place-photo proxy URLs.
BACKEND_PUBLIC_URL=http://localhost:8000

# Closed-beta defaults are deterministic and require no external credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./tableus-dev.db
# Staging/production only: privileged Alembic credential, separate from runtime.
MIGRATION_DATABASE_URL=
# Staging/production only: pre-created least-privilege runtime login role.
TABLEUS_RUNTIME_DB_ROLE=
TABLEUS_AUTH_MODE=demo
TABLEUS_PROVIDER_MODE=deterministic
# Preferred split modes. When omitted, the deprecated combined value above is used.
TABLEUS_PLACES_PROVIDER_MODE=deterministic
TABLEUS_AI_PROVIDER_MODE=deterministic
TABLEUS_DEMO_MODE=true
TABLEUS_SHARED_PLANS_ENABLED=true
TABLEUS_BUILD_SHA=
TABLEUS_DEMO_INVITE=tableus-beta
TABLEUS_APP_SECRET=development-only-change-me-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Required only when TABLEUS_AUTH_MODE=supabase.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Privacy-safe telemetry is disabled when keys are empty.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Paid operator evaluation hard ceiling and rolling staging runtime ceiling.
LIVE_AI_MAX_USD=0.25
AI_RUNTIME_MAX_USD_30D=4.00
