# Local defaults need no credentials: demo sign-in and fixture restaurants.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./tableus-local.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
TABLEUS_AUTH_MODE=demo
TABLEUS_PROVIDER_MODE=deterministic

# Hosted: Supabase sign-in. The service role key lets people delete their account.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to start plans. Empty means anyone signed in.
TABLEUS_PLAN_CREATOR_EMAILS=

# Hosted: Postgres. Migrations can use a separate, more privileged role.
MIGRATION_DATABASE_URL=
TABLEUS_RUNTIME_DB_ROLE=

# Live providers cost money. Use them deliberately.
# TABLEUS_PLACES_PROVIDER_MODE=live
# TABLEUS_AI_PROVIDER_MODE=live
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Errors go to Sentry and plan-flow counts to PostHog, without
# names, emails or wishes. Each stays off while its key is empty.
SENTRY_DSN=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
