{
  "cli": {
    "version": "23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://staging.table-us.com",
        "EXPO_PUBLIC_LINK_HOST": "staging.table-us.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "extends": "staging",
      "distribution": "store"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://www.table-us.com",
        "EXPO_PUBLIC_LINK_HOST": "links.table-us.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    },
    "testflight": {
      "ios": {
        "appleTeamId": "6MHJN5V9UJ",
        "ascAppId": "6823761628"
      }
    }
  }
}
