{
  "cli": { "version": ">= 16.0.1", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "channel": "development" },
    "preview": { "distribution": "internal", "channel": "preview" },
    "test-ios": { "distribution": "internal", "channel": "preview", "ios": { "simulator": true } },
    "test-android": { "distribution": "internal", "channel": "preview", "android": { "buildType": "apk" } },
    "production": { "autoIncrement": true, "channel": "production" }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
