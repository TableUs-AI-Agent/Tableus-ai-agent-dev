{
  "cli": { "version": ">= 16.0.1", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "channel": "development", "environment": "development" },
    "preview": { "distribution": "internal", "channel": "preview", "environment": "preview" },
    "test-ios": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8000",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_DEMO_USER_ID": "demo-organizer",
        "EXPO_PUBLIC_DEMO_IDENTITIES": "demo-organizer,demo-guest",
        "TABLEUS_LOCAL_E2E": "true"
      },
      "ios": { "simulator": true }
    },
    "test-android": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8000",
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_DEMO_USER_ID": "demo-organizer",
        "EXPO_PUBLIC_DEMO_IDENTITIES": "demo-organizer,demo-guest",
        "TABLEUS_LOCAL_E2E": "true"
      },
      "android": { "buildType": "apk" }
    },
    "auth-test-ios": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "TABLEUS_LOCAL_E2E": "false",
        "TABLEUS_AUTH_E2E": "true"
      },
      "ios": { "simulator": true }
    },
    "auth-test-android": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "TABLEUS_LOCAL_E2E": "false",
        "TABLEUS_AUTH_E2E": "true"
      },
      "android": { "buildType": "apk" }
    },
    "links-test-ios": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_LINK_HOST": "links.table-us.com",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "TABLEUS_LOCAL_E2E": "false",
        "TABLEUS_AUTH_E2E": "false"
      }
    },
    "links-test-android": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_LINK_HOST": "links.table-us.com",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "TABLEUS_LOCAL_E2E": "false",
        "TABLEUS_AUTH_E2E": "false",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      },
      "android": { "buildType": "apk" }
    },
    "production": { "autoIncrement": true, "channel": "production", "environment": "production" }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
